// <cstdlib> - la cabecera de C <stdlib.h> para C++ (D228; los nombres en std::, D230).
// Las funciones están en el espacio global, como en <stdlib.h>, y también en std::
// (std::memcpy, std::abs...), como en la biblioteca de C++. La libc común
// (D210) no conoce C++: las declaraciones entran con enlace de C por los
// envoltorios que genera el Makefile (tools/cxx_envoltorios.py).
#ifndef SAGUI_CXX_CSTDLIB
#define SAGUI_CXX_CSTDLIB
#pragma GCC system_header
#include <stdlib.h>

namespace std {
