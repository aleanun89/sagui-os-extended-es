using ::bsearch;
using ::rand;
using ::srand;
#ifndef SAGUI_CXX_ABS_SOBRECARGAS
#define SAGUI_CXX_ABS_SOBRECARGAS
// std::abs para todos los tipos (lo comparten <cstdlib> y <cmath>).
using ::abs;
inline long abs(long x) { return x < 0 ? -x : x; }
inline long long abs(long long x) { return x < 0 ? -x : x; }
inline double abs(double x) { return __builtin_fabs(x); }
inline float abs(float x) { return __builtin_fabsf(x); }
inline long double abs(long double x) { return __builtin_fabsl(x); }
#endif
} // namespace std

#endif
