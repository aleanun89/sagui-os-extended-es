using ::div_t;
using ::ldiv_t;
using ::labs;
using ::llabs;
using ::div;
using ::ldiv;
using ::atoi;
using ::atol;
using ::atoll;
using ::atof;
using ::strtol;
using ::strtoul;
using ::strtoll;
using ::strtoull;
using ::strtod;
using ::strtof;
using ::malloc;
using ::calloc;
using ::realloc;
using ::free;
using ::exit;
using ::abort;
using ::atexit;
using ::getenv;
