// <cstddef> - la cabecera de C <stddef.h> para C++ (D228; los nombres en std::, D230).
// Las funciones están en el espacio global, como en <stddef.h>, y también en std::
// (std::memcpy, std::abs...), como en la biblioteca de C++. La libc común
// (D210) no conoce C++: las declaraciones entran con enlace de C por los
// envoltorios que genera el Makefile (tools/cxx_envoltorios.py).
#ifndef SAGUI_CXX_CSTDDEF
#define SAGUI_CXX_CSTDDEF
#pragma GCC system_header
#include <stddef.h>

namespace std {
using ::size_t;
using ::ptrdiff_t;
using ::max_align_t;
typedef decltype(nullptr) nullptr_t;
} // namespace std

#endif
