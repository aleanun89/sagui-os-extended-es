#ifndef SAGUI_CXX_ALGORITHM
#define SAGUI_CXX_ALGORITHM
#pragma GCC system_header

#include <utility>
#include <iterator>

namespace std {

template <class I, class P> I find_if(I ini, I fim, P pred)
{
    for (; ini != fim; ++ini)
        if (pred(*ini)) return ini;
    return fim;
}

template <class I, class T> I find(I ini, I fim, const T &v)
{
    for (; ini != fim; ++ini)
        if (*ini == v) return ini;
    return fim;
}

template <class I, class F> F for_each(I ini, I fim, F f)
{
    for (; ini != fim; ++ini) f(*ini);
    return f;
}

template <class I, class O> O copy(I ini, I fim, O dest)
{
    for (; ini != fim; ++ini, ++dest) *dest = *ini;
    return dest;
}

template <class I, class T> void fill(I ini, I fim, const T &v)
{
    for (; ini != fim; ++ini) *ini = v;
}

template <class T> constexpr const T &min(const T &a, const T &b) { return b < a ? b : a; }
template <class T> constexpr const T &max(const T &a, const T &b) { return a < b ? b : a; }
template <class T> constexpr const T &clamp(const T &v, const T &lo, const T &hi)
{
    return v < lo ? lo : (hi < v ? hi : v);
}

template <class I, class O, class F> O transform(I ini, I fim, O dest, F f)
{
    for (; ini != fim; ++ini, ++dest) *dest = f(*ini);
    return dest;
}

template <class I1, class I2, class O, class F> O transform(I1 a, I1 fim, I2 b, O dest, F f)
{
    for (; a != fim; ++a, ++b, ++dest) *dest = f(*a, *b);
    return dest;
}

template <class I, class T> typename iterator_traits<I>::difference_type count(I ini, I fim, const T &v)
{
    typename iterator_traits<I>::difference_type n = 0;
    for (; ini != fim; ++ini)
        if (*ini == v) n++;
    return n;
}

template <class I, class P> bool any_of(I ini, I fim, P pred) { return find_if(ini, fim, pred) != fim; }
template <class I, class P> bool all_of(I ini, I fim, P pred)
{
    for (; ini != fim; ++ini)
        if (!pred(*ini)) return false;
    return true;
}

template <class I1, class I2> bool equal(I1 a, I1 fim, I2 b)
{
    for (; a != fim; ++a, ++b)
        if (!(*a == *b)) return false;
    return true;
}

template <class I, class O> O copy_n(I ini, size_t n, O dest)
{
    for (; n > 0; --n, ++ini, ++dest) *dest = *ini;
    return dest;
}

template <class I, class O> O copy_backward(I ini, I fim, O dest)
{
    while (fim != ini) *--dest = *--fim;
    return dest;
}

template <class I1, class I2> void iter_swap(I1 a, I2 b)
{
    auto t = std::move(*a);
    *a = std::move(*b);
    *b = std::move(t);
}

template <class I> void reverse(I ini, I fim)
{
    while (ini != fim && ini != --fim) {
        iter_swap(ini, fim);
        ++ini;
    }
}

template <class I> I min_element(I ini, I fim)
{
    I m = ini;
    if (ini == fim) return fim;
    for (++ini; ini != fim; ++ini)
        if (*ini < *m) m = ini;
    return m;
}

template <class I> I max_element(I ini, I fim)
{
    I m = ini;
    if (ini == fim) return fim;
    for (++ini; ini != fim; ++ini)
        if (*m < *ini) m = ini;
    return m;
}

template <class I, class T> I lower_bound(I ini, I fim, const T &v)
{
    ptrdiff_t n = distance(ini, fim);
    while (n > 0) {
        ptrdiff_t m = n / 2;
        I p = ini;
        advance(p, m);
        if (*p < v) { ini = ++p; n -= m + 1; } else n = m;
    }
    return ini;
}

template <class I, class T> I upper_bound(I ini, I fim, const T &v)
{
    ptrdiff_t n = distance(ini, fim);
    while (n > 0) {
        ptrdiff_t m = n / 2;
        I p = ini;
        advance(p, m);
        if (!(v < *p)) { ini = ++p; n -= m + 1; } else n = m;
    }
    return ini;
}

template <class I, class P> I remove_if(I ini, I fim, P pred)
{
    I o = ini;
    for (; ini != fim; ++ini)
        if (!pred(*ini)) { if (o != ini) *o = std::move(*ini); ++o; }
    return o;
}

template <class I, class T> I remove(I ini, I fim, const T &v)
{
    I o = ini;
    for (; ini != fim; ++ini)
        if (!(*ini == v)) { if (o != ini) *o = std::move(*ini); ++o; }
    return o;
}

template <class I> I unique(I ini, I fim)
{
    if (ini == fim) return fim;
    I o = ini;
    while (++ini != fim)
        if (!(*o == *ini)) *++o = std::move(*ini);
    return ++o;
}

namespace detalhe_alg {

struct menor {
    template <class A, class B> bool operator()(const A &a, const B &b) const { return a < b; }
};

template <class I, class C> void inserir(I ini, I fim, C cmp)
{
    if (ini == fim) return;
    for (I i = ini + 1; i != fim; ++i) {
        auto v = std::move(*i);
        I j = i;
        for (; j != ini && cmp(v, *(j - 1)); --j) *j = std::move(*(j - 1));
        *j = std::move(v);
    }
}

template <class I, class C> void peneirar(I base, ptrdiff_t i, ptrdiff_t n, C cmp)
{
    for (;;) {
        ptrdiff_t f = 2 * i + 1;
        if (f >= n) return;
        if (f + 1 < n && cmp(*(base + f), *(base + f + 1))) f++;
        if (!cmp(*(base + i), *(base + f))) return;
        iter_swap(base + i, base + f);
        i = f;
    }
}

template <class I, class C> void monte(I ini, I fim, C cmp)
{
    ptrdiff_t n = fim - ini;
    for (ptrdiff_t i = n / 2 - 1; i >= 0; --i) peneirar(ini, i, n, cmp);
    for (ptrdiff_t k = n - 1; k > 0; --k) {
        iter_swap(ini, ini + k);
        peneirar(ini, 0, k, cmp);
    }
}

// Quicksort con mediana de tres, inserción en lo pequeño y montón si se degenera.
template <class I, class C> void ordenar(I ini, I fim, C cmp, int prof)
{
    while (fim - ini > 16) {
        if (prof-- == 0) { monte(ini, fim, cmp); return; }
        I m = ini + (fim - ini) / 2, u = fim - 1;
        if (cmp(*m, *ini)) iter_swap(m, ini);
        if (cmp(*u, *m)) { iter_swap(u, m); if (cmp(*m, *ini)) iter_swap(m, ini); }
        auto p = *m;
        I a = ini, b = u;
        for (;;) {
            while (cmp(*a, p)) ++a;
            while (cmp(p, *b)) --b;
            if (a >= b) break;
            iter_swap(a, b);
            ++a;
            --b;
        }
        // [ini, b] y [b+1, fim)
        I corte = b + 1;
        if (corte - ini < fim - corte) { ordenar(ini, corte, cmp, prof); ini = corte; }
        else { ordenar(corte, fim, cmp, prof); fim = corte; }
    }
    inserir(ini, fim, cmp);
}

} // namespace detalhe_alg

template <class I, class C> void sort(I ini, I fim, C cmp)
{
    detalhe_alg::ordenar(ini, fim, cmp, 64);
}
template <class I> void sort(I ini, I fim) { sort(ini, fim, detalhe_alg::menor()); }

// Estable: inserción (O(n^2), pensado para listas cortas) en vez de mezcla.
template <class I, class C> void stable_sort(I ini, I fim, C cmp) { detalhe_alg::inserir(ini, fim, cmp); }
template <class I> void stable_sort(I ini, I fim) { stable_sort(ini, fim, detalhe_alg::menor()); }

} // namespace std

#endif
