// <memory> - unique_ptr y make_unique (D228).
#ifndef SAGUI_CXX_MEMORY
#define SAGUI_CXX_MEMORY
#pragma GCC system_header

#include <stddef.h>
#include <new>
#include <utility>

namespace std {

template <class T> struct default_delete {
    constexpr default_delete() noexcept = default;
    template <class U> default_delete(const default_delete<U> &) noexcept {}
    void operator()(T *p) const { delete p; }
};
template <class T> struct default_delete<T[]> {
    constexpr default_delete() noexcept = default;
    void operator()(T *p) const { delete[] p; }
};

template <class T, class D = default_delete<T>> class unique_ptr {
    T *p;
    D d;
public:
    typedef T *pointer;
    typedef T element_type;
    constexpr unique_ptr() noexcept : p(nullptr), d() {}
    constexpr unique_ptr(decltype(nullptr)) noexcept : p(nullptr), d() {}
    explicit unique_ptr(T *q) noexcept : p(q), d() {}
    unique_ptr(T *q, const D &del) noexcept : p(q), d(del) {}
    unique_ptr(unique_ptr &&o) noexcept : p(o.release()), d(std::move(o.d)) {}
    template <class U, class E> unique_ptr(unique_ptr<U, E> &&o) noexcept : p(o.release()), d() {}
    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;
    ~unique_ptr() { if (p) d(p); }
    unique_ptr &operator=(unique_ptr &&o) noexcept { reset(o.release()); return *this; }
    template <class U, class E> unique_ptr &operator=(unique_ptr<U, E> &&o) noexcept { reset(o.release()); return *this; }
    unique_ptr &operator=(decltype(nullptr)) noexcept { reset(); return *this; }
    T *get() const noexcept { return p; }
    T *release() noexcept { T *q = p; p = nullptr; return q; }
    void reset(T *q = nullptr) noexcept { T *v = p; p = q; if (v) d(v); }
    void swap(unique_ptr &o) noexcept { T *t = p; p = o.p; o.p = t; }
    D &get_deleter() noexcept { return d; }
    T &operator*() const { return *p; }
    T *operator->() const noexcept { return p; }
    explicit operator bool() const noexcept { return p != nullptr; }
};

template <class T, class D> class unique_ptr<T[], D> {
    T *p;
    D d;
public:
    typedef T *pointer;
    typedef T element_type;
    constexpr unique_ptr() noexcept : p(nullptr), d() {}
    constexpr unique_ptr(decltype(nullptr)) noexcept : p(nullptr), d() {}
    explicit unique_ptr(T *q) noexcept : p(q), d() {}
    unique_ptr(unique_ptr &&o) noexcept : p(o.release()), d(std::move(o.d)) {}
    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;
    ~unique_ptr() { if (p) d(p); }
    unique_ptr &operator=(unique_ptr &&o) noexcept { reset(o.release()); return *this; }
    unique_ptr &operator=(decltype(nullptr)) noexcept { reset(); return *this; }
    T *get() const noexcept { return p; }
    T *release() noexcept { T *q = p; p = nullptr; return q; }
    void reset(T *q = nullptr) noexcept { T *v = p; p = q; if (v) d(v); }
    T &operator[](size_t i) const { return p[i]; }
    explicit operator bool() const noexcept { return p != nullptr; }
};

template <class T, class D> bool operator==(const unique_ptr<T, D> &a, decltype(nullptr)) noexcept { return !a; }
template <class T, class D> bool operator!=(const unique_ptr<T, D> &a, decltype(nullptr)) noexcept { return (bool)a; }

template <class T> struct _sagui_unico { typedef unique_ptr<T> simples; };
template <class T> struct _sagui_unico<T[]> { typedef unique_ptr<T[]> matriz; };

template <class T, class... A> typename _sagui_unico<T>::simples make_unique(A &&...args)
{
    return unique_ptr<T>(new T(std::forward<A>(args)...));
}
template <class T> typename _sagui_unico<T>::matriz make_unique(size_t n)
{
    return unique_ptr<T>(new typename remove_extent<T>::type[n]());
}

} // namespace std

#endif
