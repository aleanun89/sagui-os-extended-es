class ifstream : public istream {
public:
    ifstream() { iniciar(&buf); clear(failbit); }
    explicit ifstream(const char *nome, ios_base::openmode m = ios_base::in) { iniciar(&buf); open(nome, m); }
    explicit ifstream(const string &nome, ios_base::openmode m = ios_base::in) { iniciar(&buf); open(nome.c_str(), m); }
    void open(const char *nome, ios_base::openmode m = ios_base::in)
    {
        clear(buf.abrir(nome, m | ios_base::in) ? goodbit : failbit);
    }
    void open(const string &nome, ios_base::openmode m = ios_base::in) { open(nome.c_str(), m); }
    bool is_open() const { return buf.aberto(); }
    void close() { if (!buf.fechar()) setstate(failbit); }
    filebuf *rdbuf() { return &buf; }
private:
    filebuf buf;
};

