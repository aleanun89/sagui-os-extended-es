// ---- los búferes ----
class stringbuf : public streambuf {
public:
    explicit stringbuf(ios_base::openmode m = ios_base::in | ios_base::out) : modo(m), pl(0), pe(0) {}
    explicit stringbuf(const string &s, ios_base::openmode m = ios_base::in | ios_base::out) : modo(m), dados(s), pl(0), pe(0)
    {
        if (m & ios_base::ate) { pe = dados.size(); }
    }
    string str() const { return dados; }
    void str(const string &s) { dados = s; pl = 0; pe = (modo & ios_base::ate) ? dados.size() : 0; }
    int ler() override
    {
        if (pl >= dados.size()) return -1;
        return (unsigned char)dados[pl++];
    }
    int espiar() override { return pl >= dados.size() ? -1 : (unsigned char)dados[pl]; }
    bool devolver(int) override
    {
        if (pl == 0) return false;
        pl--;
        return true;
    }
    bool escrever(int c) override
    {
        if (modo & ios_base::app) pe = dados.size();
        if (pe >= dados.size()) dados.resize(pe + 1);
        dados[pe++] = (char)c;
        return true;
    }
    long buscar(long desl, int de, bool escrita) override
    {
        long base = de == ios_base::beg ? 0 : de == ios_base::cur ? (long)(escrita ? pe : pl) : (long)dados.size();
        long p = base + desl;
        if (p < 0 || p > (long)dados.size()) return -1;
        if (escrita) pe = (size_t)p;
        else pl = (size_t)p;
        return p;
    }

private:
    ios_base::openmode modo;
    string dados;
    size_t pl, pe;
};

class filebuf : public streambuf {
public:
    filebuf() : fp(nullptr), propio(false) {}
    explicit filebuf(FILE *f) : fp(f), propio(false) {}
    ~filebuf() override { fechar(); }
    bool aberto() const { return fp != nullptr; }
    filebuf *abrir(const char *nome, ios_base::openmode m)
    {
        if (fp) return nullptr;
        const char *modo;
        bool in = m & ios_base::in, out = m & ios_base::out, app = m & ios_base::app, tr = m & ios_base::trunc;
        if (app) modo = in ? "a+b" : "ab";
        else if (out && in) modo = tr ? "w+b" : "r+b";
        else if (out) modo = "wb";
        else if (in) modo = "rb";
        else return nullptr;
        fp = fopen(nome, modo);
        if (!fp) return nullptr;
        propio = true;
        if (m & ios_base::ate) fseek(fp, 0, SEEK_END);
        return this;
    }
    bool fechar()
    {
        if (!fp) return false;
        int r = propio ? fclose(fp) : fflush(fp);
        fp = nullptr;
        return r == 0;
    }
    int ler() override
    {
        if (!fp) return -1;
        int c = fgetc(fp);
        return c == EOF ? -1 : c;
    }
    int espiar() override
    {
        if (!fp) return -1;
        int c = fgetc(fp);
        if (c == EOF) return -1;
        ungetc(c, fp);
        return c;
    }
    bool devolver(int c) override
    {
        if (!fp) return false;
        if (c) return ungetc(c, fp) != EOF;
        return fseek(fp, -1, SEEK_CUR) == 0;
    }
    bool escrever(int c) override { return fp && fputc(c, fp) != EOF; }
    bool descarregar() override { return !fp || fflush(fp) == 0; }
    long buscar(long desl, int de, bool) override
    {
        if (!fp) return -1;
        if (fseek(fp, desl, de == ios_base::beg ? SEEK_SET : de == ios_base::cur ? SEEK_CUR : SEEK_END) != 0) return -1;
        return ftell(fp);
    }

private:
    FILE *fp;
    bool propio;
};

