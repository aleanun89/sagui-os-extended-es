// <cassert> - la cabecera de C <assert.h> para C++ (D228).
// Las funciones quedan en el espacio global, como en <assert.h>; los ports las
// usan así. La libc común (D210) no conoce C++: las declaraciones entran con
// enlace de C por los envoltorios que genera el Makefile (tools/cxx_envoltorios.py).
#ifndef SAGUI_CXX_CASSERT
#define SAGUI_CXX_CASSERT
#pragma GCC system_header
#include <assert.h>
#endif
