// <cctype> - la cabecera de C <ctype.h> para C++ (D228; los nombres en std::, D230).
// Las funciones están en el espacio global, como en <ctype.h>, y también en std::
// (std::memcpy, std::abs...), como en la biblioteca de C++. La libc común
// (D210) no conoce C++: las declaraciones entran con enlace de C por los
// envoltorios que genera el Makefile (tools/cxx_envoltorios.py).
#ifndef SAGUI_CXX_CCTYPE
#define SAGUI_CXX_CCTYPE
#pragma GCC system_header
#include <ctype.h>

namespace std {
using ::isalnum;
using ::isalpha;
using ::isblank;
using ::iscntrl;
using ::isdigit;
using ::isgraph;
using ::islower;
using ::isprint;
using ::ispunct;
using ::isspace;
using ::isupper;
using ::isxdigit;
using ::tolower;
using ::toupper;
} // namespace std

#endif
