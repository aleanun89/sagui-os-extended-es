--- a/client/connectdlg_common.c
+++ b/client/connectdlg_common.c
@@ -367,7 +367,18 @@
       astr_free(&srv_cmdline_opts);
     }
 
+#ifdef SAGUI_FREECIV
+    /* D374: sin fork(): el servidor es otro proceso que se lanza con executar() y habla por TCP */
+    {
+      extern int executar(const char *caminho, char *const argv[]);
+      server_pid = executar("/apps/bin/freeciv-server", argv);
+      if (server_pid < 0) {
+        server_pid = -1;
+      }
+    }
+#else
     server_pid = fork();
+#endif
     server_quitting = FALSE;
 
     if (server_pid == 0) {
