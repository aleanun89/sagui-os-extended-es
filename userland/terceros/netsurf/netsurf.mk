# netsurf.mk - cómo se compila /bin/netsurf (D184). Lo incluye el Makefile
# principal cuando las fuentes están preparadas (tools/netsurf_fuentes.sh) y
# la variante no es la sin GPL (D109).
#
# NetSurf y sus bibliotecas son código del upstream, sin tocar, que vive en
# fuentes/ (fuera de git). Lo nuestro: la libc común (userland/libc, D210;
# aquí, en libc/, solo queda la cabecera de curl que no se usa) y plataforma/
# (la superficie de libnsfb sobre las ventanas del SO, el arranque y lo que
# falta). Todo compila con la x87 (NetSurf usa números reales en el layout y
# en el CSS), como el OpenTyrian.

NS_DIR   := userland/terceros/netsurf
NS_VER   := 3.11
NS_SRC   := $(NS_DIR)/fuentes/netsurf-all-$(NS_VER)
NS_GER   := $(NS_DIR)/fuentes/gerado
NS_OBJ   := $(B)/$(NS_DIR)

# --------------------------------------------------------------- banderas
# Sin CPATH: el entorno local (env.sh) lo apunta a las cabeceras del
# anfitrión, que valen incluso con -nostdinc, y NetSurf se compilaría contra
# la glibc sin que nadie se enterara.
NS_CC := env -u CPATH -u C_INCLUDE_PATH $(CC)

# Las de todos: sin libc del anfitrión, cabeceras de la libc común (y de
# libc/, la de curl) antes que las del gcc.
NS_BASE := -m32 -march=i686 -std=gnu99 -Os \
  -ffreestanding -fno-builtin -nostdlib -fno-pic -fno-pie \
  -fno-stack-protector -fno-asynchronous-unwind-tables \
  -ffunction-sections -fdata-sections -DNDEBUG -fcommon \
  -mfpmath=387 -fexcess-precision=standard \
  -nostdinc -I$(LIBC_DIR) -I$(NS_DIR)/libc -isystem $(shell $(CC) -print-file-name=include) \
  -D_BSD_SOURCE -D_DEFAULT_SOURCE -D_POSIX_C_SOURCE=200809L -D_XOPEN_SOURCE=700 \
  -DSAGUI_NETSURF \
  -w

NS_INC := -I$(NS_SRC)/libwapcaplet/include -I$(NS_SRC)/libparserutils/include \
  -I$(NS_SRC)/libhubbub/include -I$(NS_SRC)/libdom/include \
  -I$(NS_SRC)/libcss/include -I$(NS_SRC)/libnsutils/include \
  -I$(NS_SRC)/libnsbmp/include -I$(NS_SRC)/libnsgif/include \
  -I$(NS_SRC)/libutf8proc/include -I$(NS_SRC)/libnsfb/include

# --------------------------------------------------------------- bibliotecas
NS_WAP_SRC := $(NS_SRC)/libwapcaplet/src/libwapcaplet.c
NS_PU_SRC  := $(wildcard $(NS_SRC)/libparserutils/src/*/*.c $(NS_SRC)/libparserutils/src/charset/codecs/*.c $(NS_SRC)/libparserutils/src/charset/encodings/*.c)
NS_HUB_SRC := $(filter-out %/autogenerated-element-type.c,$(wildcard $(NS_SRC)/libhubbub/src/*.c $(NS_SRC)/libhubbub/src/*/*.c))
NS_DOM_SRC := $(wildcard $(NS_SRC)/libdom/src/*/*.c) $(NS_SRC)/libdom/bindings/hubbub/parser.c
NS_CSS_SRC := $(filter-out %/css_property_parser_gen.c,$(wildcard $(NS_SRC)/libcss/src/*.c $(NS_SRC)/libcss/src/*/*.c $(NS_SRC)/libcss/src/*/*/*.c))
NS_NSU_SRC := $(wildcard $(NS_SRC)/libnsutils/src/*.c)
NS_BMP_SRC := $(NS_SRC)/libnsbmp/src/libnsbmp.c
NS_GIF_SRC := $(wildcard $(NS_SRC)/libnsgif/src/*.c)
NS_U8P_SRC := $(NS_SRC)/libutf8proc/src/utf8proc.c
NS_FB_SRC  := $(addprefix $(NS_SRC)/libnsfb/src/,libnsfb.c dump.c cursor.c palette.c \
  surface/surface.c surface/ram.c plot/api.c plot/util.c plot/generic.c \
  plot/32bpp-xrgb8888.c plot/32bpp-xbgr8888.c plot/16bpp.c plot/8bpp.c)

NS_LIB_SRC := $(NS_WAP_SRC) $(NS_PU_SRC) $(NS_HUB_SRC) $(NS_DOM_SRC) $(NS_CSS_SRC) \
  $(NS_NSU_SRC) $(NS_BMP_SRC) $(NS_GIF_SRC) $(NS_U8P_SRC) $(NS_FB_SRC)

# Cada biblioteca ve su propio src/ (sus cabeceras internas tienen nombres
# repetidos entre bibliotecas: utils/utils.h, etc.).
ns_lib_de = $(word 1,$(subst /, ,$(patsubst $(NS_SRC)/%,%,$(1))))
NS_FLAGS_libparserutils := -DWITHOUT_ICONV_FILTER
NS_FLAGS_libdom         := -I$(NS_SRC)/libdom/bindings
NS_FLAGS_libnsgif       := -DNSGIF_NAME=libnsgif -DNSGIF_VERSION=1.0.0
NS_FLAGS_libutf8proc    := -I$(NS_SRC)/libutf8proc/include/libutf8proc -DUTF8PROC_EXPORTS
NS_FLAGS_libnsfb        := -D_POSIX_C_SOURCE=200112L

# Los objetos dependen también de este fichero: si cambian las opciones
# (por ejemplo NETSURF_FB_RESPATH, D194), se recompilan (no quedan objetos viejos).
$(NS_OBJ)/lib/%.o: $(NS_SRC)/%.c $(NS_DIR)/fuentes/.preparado $(LIBC_HDR) $(wildcard $(NS_DIR)/libc/*/*.h) $(NS_DIR)/netsurf.mk
	@mkdir -p $(dir $@)
	$(NS_CC) $(NS_BASE) $(NS_INC) -I$(NS_SRC)/$(call ns_lib_de,$<)/src $(NS_FLAGS_$(call ns_lib_de,$<)) -c -o $@ $<

NS_LIB_OBJ := $(patsubst $(NS_SRC)/%.c,$(NS_OBJ)/lib/%.o,$(filter-out $(NS_SRC)/netsurf/%,$(NS_LIB_SRC)))

# --------------------------------------------------------------- NetSurf
# La lista sale de "make -n TARGET=framebuffer" del upstream con curl, openssl,
# png, jpeg, svg, sprite, webp, jxl, psl, nslog y duktape apagados.
