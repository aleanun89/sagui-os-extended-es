  utils/punycode.c utils/ssl_certs.c utils/talloc.c utils/time.c utils/url.c \
  utils/useragent.c utils/utf8.c utils/utils.c

# Dónde busca el frontend sus recursos (Messages, default.css...): en la
# imagen, /apps/netsurf (D194: NetSurf es una aplicación de /apps, en la
# partición SAGUI-APPS o, con APPS=0, en el ramdisk; ver NS_RECURSOS más abajo).
# /usr/share/netsurf queda detrás por si alguien copia ahí los recursos.
NS_DEFS := -DWITH_BMP -DWITH_GIF -DWITH_UTF8PROC -UWITH_JPEG -UWITH_PDF_EXPORT \
  -Dnsframebuffer -Dsmall -DSTMTEXPR=1 \
  '-DNETSURF_UA_FORMAT_STRING="Mozilla/5.0 (%s) NetSurf/%d.%d"' \
  '-DNETSURF_HOMEPAGE="about:welcome"' -DNETSURF_LOG_LEVEL=WARNING \
  '-DNETSURF_BUILTIN_LOG_FILTER="(level:WARNING)"' \
  '-DNETSURF_BUILTIN_VERBOSE_FILTER="(level:VERBOSE)"' \
  '-DNETSURF_FB_RESPATH="$${HOME}/.netsurf/:/apps/netsurf:/usr/share/netsurf"' \
  '-DNETSURF_FB_FONTPATH="/apps/netsurf"' \
  '-DNETSURF_FB_FONT_SANS_SERIF="x"' '-DNETSURF_FB_FONT_SANS_SERIF_BOLD="x"' \
  '-DNETSURF_FB_FONT_SANS_SERIF_ITALIC="x"' '-DNETSURF_FB_FONT_SANS_SERIF_ITALIC_BOLD="x"' \
  '-DNETSURF_FB_FONT_SERIF="x"' '-DNETSURF_FB_FONT_SERIF_BOLD="x"' \
  '-DNETSURF_FB_FONT_MONOSPACE="x"' '-DNETSURF_FB_FONT_MONOSPACE_BOLD="x"' \
  '-DNETSURF_FB_FONT_CURSIVE="x"' '-DNETSURF_FB_FONT_FANTASY="x"'

NS_NS_INC := -I$(NS_SRC)/netsurf -I$(NS_SRC)/netsurf/include -I$(NS_GER) -I$(NS_GER)/include \
  -I$(NS_SRC)/netsurf/frontends -I$(NS_SRC)/netsurf/content/handlers

$(NS_OBJ)/ns/%.o: $(NS_SRC)/netsurf/%.c $(NS_DIR)/fuentes/.preparado $(LIBC_HDR) $(wildcard $(NS_DIR)/libc/*/*.h) $(NS_DIR)/netsurf.mk
	@mkdir -p $(dir $@)
	$(NS_CC) $(NS_BASE) $(NS_INC) $(NS_NS_INC) $(NS_DEFS) -c -o $@ $<

$(NS_OBJ)/gerado/%.o: $(NS_GER)/%.c $(NS_DIR)/fuentes/.preparado $(NS_DIR)/netsurf.mk
	@mkdir -p $(dir $@)
	$(NS_CC) $(NS_BASE) $(NS_INC) $(NS_NS_INC) $(NS_DEFS) -c -o $@ $<

NS_GER_OBJ := $(patsubst $(NS_GER)/%.c,$(NS_OBJ)/gerado/%.o,$(wildcard $(NS_GER)/*.c))
NS_CORE_OBJ := $(patsubst %.c,$(NS_OBJ)/ns/%.o,$(NS_CORE))

# --------------------------------------------------------------- lo nuestro
NS_PLAT_SRC := $(wildcard $(NS_DIR)/plataforma/*.c)
NS_NOSSO_HDR := $(LIBC_HDR) $(wildcard $(NS_DIR)/libc/*/*.h $(NS_DIR)/plataforma/*.h)

# La plataforma ve la libsagui (sagui.h, gui.h) además de la libc.
$(NS_OBJ)/plataforma/%.o: $(NS_DIR)/plataforma/%.c $(NS_NOSSO_HDR) $(USER_HDR) $(NS_DIR)/fuentes/.preparado $(NS_DIR)/netsurf.mk
	@mkdir -p $(dir $@)
	$(NS_CC) $(filter-out -w,$(NS_BASE)) -Wall -Wno-unused-parameter $(NS_INC) -I$(NS_SRC)/libnsfb/src \
	  $(NS_NS_INC) $(NS_DEFS) -Iuserland/inc -idirafter kernel/inc -finput-charset=UTF-8 -fexec-charset=ISO-8859-1 -c -o $@ $<

NS_NOSSO_OBJ := $(patsubst $(NS_DIR)/%.c,$(NS_OBJ)/%.o,$(NS_PLAT_SRC)) $(LIBC_OBJ)

NS_TODOS_OBJ := $(NS_LIB_OBJ) $(NS_CORE_OBJ) $(NS_GER_OBJ) $(NS_NOSSO_OBJ)

# El enlace usa su propio guion: NetSurf (libnsfb) registra las superficies
# con constructores (.init_array), que el programa.ld de los demás descarta.
$(B)/userland/bin/netsurf: $(NS_TODOS_OBJ) $(QJS_LIBM) $(TLS_OBJ) $(LIBSAGUI_OBJ) $(NS_DIR)/plataforma/netsurf.ld
	@mkdir -p $(dir $@)
	$(LD) -m elf_i386 -nostdlib -T $(NS_DIR)/plataforma/netsurf.ld --gc-sections -z max-page-size=4096 \
	  -z noexecstack --no-warn-rwx-segments -o $@.elf $(NS_TODOS_OBJ) $(QJS_LIBM) $(TLS_OBJ) $(LIBSAGUI_OBJ)
	objcopy --strip-all $@.elf $@
	@$(PY) $(CHECK_ELF32) $@.elf

.PHONY: netsurf-libs
netsurf-libs: $(NS_LIB_OBJ)

.PHONY: netsurf-objs
netsurf-objs: $(NS_CORE_OBJ) $(NS_GER_OBJ)

# --------------------------------------------------------------- recursos
# Lo que el frontend lee en marcha (la lista del "install-framebuffer" del
# upstream): hojas de estilo, páginas internas (about:welcome...), el icono y
# los mensajes. Van a /apps/netsurf (NETSURF_FB_RESPATH, arriba), con la
# licencia de NetSurf al lado.
NS_RES_FB := $(NS_SRC)/netsurf/frontends/framebuffer/res
NS_RECURSOS := $(B)/netsurf-res/.feito
$(NS_RECURSOS): $(NS_DIR)/fuentes/.preparado $(wildcard $(NS_DIR)/plataforma/recursos/*)
	@set -e; rm -rf $(B)/netsurf-res; mkdir -p $(B)/netsurf-res; \
	for f in adblock.css credits.html default.css internal.css licence.html netsurf.png quirks.css welcome.html; do \
	  cp -L $(NS_RES_FB)/$$f $(B)/netsurf-res/$$f; done; \
	cp $(NS_GER)/res/en/Messages $(B)/netsurf-res/Messages; \
	cp $(NS_SRC)/netsurf/COPYING $(B)/netsurf-res/COPYING; \
	if [ -d $(NS_DIR)/plataforma/recursos ]; then cp $(NS_DIR)/plataforma/recursos/* $(B)/netsurf-res/; fi; \
	touch $@

# D194: NetSurf no es de la base: va a /apps/bin (la partición SAGUI-APPS),
# no a /bin, y sus recursos a /apps/netsurf (APPS_RECURSOS, ver el Makefile).
APPS_BINS += $(B)/userland/bin/netsurf
APPS_RECURSOS += netsurf:$(B)/netsurf-res
