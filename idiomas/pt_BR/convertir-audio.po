#: userland/programas/convertir-audio.c:677
msgid "MP3 a 11,025 kHz es MPEG-2.5: muchos reproductores no lo leen"
msgstr "MP3 a 11,025 kHz é MPEG-2.5: muitos players não o leem"

#: userland/programas/convertir-audio.c:678
msgid "A esa frecuencia el MP3 admite como mucho 160 kbps"
msgstr "Nessa frequência o MP3 admite no máximo 160 kbps"

