#: userland/programas/convertir-audio.c:183 userland/programas/convertir-audio.c:322 userland/programas/convertir-audio.c:557
#, c-format
msgid "%s: %s"
msgstr "%s: %s"

#: userland/programas/convertir-audio.c:200
msgid "Esta versión no incluye el codificador MP3"
msgstr "Esta versão não inclui o codificador MP3"

#: userland/programas/convertir-audio.c:214
#, c-format
msgid "No se puede crear %s"
msgstr "Não é possível criar %s"

#: userland/programas/convertir-audio.c:244
msgid "No se pudo iniciar el codificador"
msgstr "Não foi possível iniciar o codificador"

#: userland/programas/convertir-audio.c:345 userland/programas/convertir-audio.c:357
msgid "Error al escribir el archivo (¿disco lleno?)"
msgstr "Erro ao gravar o arquivo (disco cheio?)"

#: userland/programas/convertir-audio.c:382
msgid "Uso: convertir-audio ENTRADA... SALIDA [opciones]\n"
msgstr "Uso: convertir-audio ENTRADA... SAÍDA [opções]\n"

#: userland/programas/convertir-audio.c:383
msgid "  SALIDA con extensión .mp3, .flac o .wav (con varias entradas, una carpeta y --formato).\n"
msgstr "  SAÍDA com extensão .mp3, .flac ou .wav (com várias entradas, uma pasta e --formato).\n"

#: userland/programas/convertir-audio.c:384
msgid "  --kbps N      MP3: tasa de bits constante, 64 a 320 (por omisión, 128)\n"
msgstr "  --kbps N      MP3: taxa de bits constante, 64 a 320 (padrão 128)\n"

#: userland/programas/convertir-audio.c:385
msgid "  --nivel N     FLAC: nivel de compresión, 0 a 8 (por omisión, 5)\n"
msgstr "  --nivel N     FLAC: nível de compressão, 0 a 8 (padrão 5)\n"

#: userland/programas/convertir-audio.c:386
msgid "  --taxa HZ     frecuencia de salida: 44100, 22050 u 11025 (por omisión, la del original)\n"
msgstr "  --taxa HZ     frequência de saída: 44100, 22050 ou 11025 (padrão: a do original)\n"

#: userland/programas/convertir-audio.c:387
msgid "  --canales N   1 (mono) o 2 (estéreo) (por omisión, los del original)\n"
msgstr "  --canales N   1 (mono) ou 2 (estéreo) (padrão: os do original)\n"

#: userland/programas/convertir-audio.c:388
msgid "  --bits N      WAV: 8 o 16 (por omisión, 16)\n"
msgstr "  --bits N      WAV: 8 ou 16 (padrão 16)\n"

#: userland/programas/convertir-audio.c:389
msgid "  --formato F   mp3, flac o wav, si SALIDA es una carpeta\n"
msgstr "  --formato F   mp3, flac ou wav, se SAÍDA é uma pasta\n"

#: userland/programas/convertir-audio.c:390
msgid "  -y            sobrescribe sin preguntar\n"
msgstr "  -y            sobrescreve sem perguntar\n"

#: userland/programas/convertir-audio.c:391
msgid "Sin nombres abre la ventana del Conversor de audio.\n"
msgstr "Sem nomes abre a janela do Conversor de áudio.\n"

#: userland/programas/convertir-audio.c:423
#, c-format
msgid "%s -> %s (%s): %u ms de audio en %u ms\n"
msgstr "%s -> %s (%s): %u ms de áudio em %u ms\n"

