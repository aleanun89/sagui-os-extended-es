# Traducción de SaguiOS: catálogo «debug-app», idioma en (D313).
# Los msgid son los textos en español del código: no se cambian a mano.
msgid ""
msgstr ""
"Project-Id-Version: SaguiOS-Extended\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: userland/programas/debug-app.c:113
msgid "No hay red: este equipo no tiene dirección IP. Conecta el cable (o la Wi-Fi) y vuelve a probar."
msgstr "No network: this computer has no IP address. Plug in the cable (or the Wi-Fi) and try again."

#: userland/programas/debug-app.c:118
#, c-format
msgid "La dirección «%s» no es válida."
msgstr "The address «%s» is not valid."

#: userland/programas/debug-app.c:123
#, c-format
msgid "La dirección de este equipo (%s) no es privada: DEBUG-APP solo se abre en una red local."
msgstr "This computer's address (%s) is not private: DEBUG-APP only opens on a local network."

#: userland/programas/debug-app.c:138 userland/programas/debug-app.c:524
#, c-format
msgid "Direcciones permitidas: %s"
msgstr "Allowed addresses: %s"

#: userland/programas/debug-app.c:143
msgid "Hace falta ser administrador."
msgstr "You need to be an administrator."

#: userland/programas/debug-app.c:156 userland/programas/debug-app.c:160
msgid "No se pudo crear la tubería."
msgstr "Could not create the pipe."

#: userland/programas/debug-app.c:177
#, c-format
msgid "No se pudo lanzar sshd: %s"
msgstr "Could not start sshd: %s"

#: userland/programas/debug-app.c:185
msgid "Preparando..."
msgstr "Preparing..."

#: userland/programas/debug-app.c:200
#, c-format
msgid "Sesión cerrada: %s"
msgstr "Session closed: %s"

#: userland/programas/debug-app.c:223
msgid "Esperando la conexión del otro equipo."
msgstr "Waiting for the other computer to connect."

#: userland/programas/debug-app.c:226
#, c-format
msgid "Conexión de %s: comprobando la clave..."
msgstr "Connection from %s: checking the key..."

#: userland/programas/debug-app.c:231
#, c-format
msgid "CONECTADO desde %s (como root). El código ya no vale."
msgstr "CONNECTED from %s (as root). The code is no longer valid."

#: userland/programas/debug-app.c:233
#, c-format
msgid "DEBUG-APP: %s ha entrado como administrador"
msgstr "DEBUG-APP: %s has logged in as administrator"

#: userland/programas/debug-app.c:236
#, c-format
msgid "Conexión rechazada: %s"
msgstr "Connection refused: %s"

#: userland/programas/debug-app.c:239
#, c-format
msgid "Una conexión probó una clave que no vale (%s de %d)."
msgstr "A connection tried an invalid key (%s of %d)."

#: userland/programas/debug-app.c:255 userland/programas/debug-app.c:269
msgid "el servidor de la sesión terminó"
msgstr "the session server ended"

#: userland/programas/debug-app.c:283
msgid "cortada"
msgstr "cut off"

#: userland/programas/debug-app.c:318
#, c-format
msgid "debug-app: falta el valor de %s\n"
msgstr "debug-app: missing value for %s\n"

#: userland/programas/debug-app.c:326
#, c-format
msgid "debug-app: opción o valor no válido: %s %s\n"
msgstr "debug-app: invalid option or value: %s %s\n"

#: userland/programas/debug-app.c:335
msgid "debug-app: las opciones guardadas permiten direcciones públicas; para eso hay que decirlo con --permitir\n"
msgstr "debug-app: the saved options allow public addresses; to do that, say so with --permitir\n"

#: userland/programas/debug-app.c:340
msgid "debug-app: hace falta ser administrador: usa «admin debug-app --texto»\n"
msgstr "debug-app: you need to be an administrator: use «admin debug-app --texto»\n"

#: userland/programas/debug-app.c:343
msgid "debug-app: no se pudieron guardar las opciones\n"
msgstr "debug-app: could not save the options\n"

#: userland/programas/debug-app.c:358
#, c-format
msgid "debug-app: no se pudo abrir la sesión: %s\n"
msgstr "debug-app: could not open the session: %s\n"

#: userland/programas/debug-app.c:358
msgid "sin respuesta de sshd"
msgstr "no answer from sshd"

#: userland/programas/debug-app.c:363
msgid "ATENCIÓN: quien tenga este código entrará en este equipo como ADMINISTRADOR (root).\n"
msgstr "WARNING: whoever has this code will log in to this computer as ADMINISTRATOR (root).\n"

#: userland/programas/debug-app.c:364
#, c-format
msgid "Código: %s\n"
msgstr "Code: %s\n"

#: userland/programas/debug-app.c:365
#, c-format
msgid "Dirección: %s  puerto %d\n"
msgstr "Address: %s  port %d\n"

#: userland/programas/debug-app.c:366
#, c-format
msgid "Huella del servidor: %s\n"
msgstr "Server fingerprint: %s\n"

#: userland/programas/debug-app.c:367
#, c-format
msgid "Permitidas: %s\n"
msgstr "Allowed: %s\n"

#: userland/programas/debug-app.c:368
#, c-format
msgid "Caduca en %s. Vale para una sola conexión. Pulsa Intro para cortar.\n"
msgstr "Expires in %s. Valid for a single connection. Press Enter to cut it off.\n"

#: userland/programas/debug-app.c:411
msgid "Depuración remota por la red local"
msgstr "Remote debugging over the local network"

#: userland/programas/debug-app.c:413
msgid "Deja que otro equipo de tu red entre en este por SSH para hacer pruebas."
msgstr "Lets another computer on your network log in to this one over SSH to run tests."

#: userland/programas/debug-app.c:415
msgid "Quien tenga el código entrará como ADMINISTRADOR (root): todo el sistema."
msgstr "Whoever has the code logs in as ADMINISTRATOR (root): the whole system."

#: userland/programas/debug-app.c:417
msgid "Una sola conexión; caduca sola; «Cortar» o cerrar la ventana la termina."
msgstr "A single connection; it expires on its own; «Cut off» or closing the window ends it."

#: userland/programas/debug-app.c:419
msgid "Dirección del código:"
msgstr "Address in the code:"

#: userland/programas/debug-app.c:419
msgid "Puerto (0 = 2222 o libre):"
msgstr "Port (0 = 2222 or free):"

#: userland/programas/debug-app.c:420
msgid "Duración (minutos, 15-480):"
msgstr "Duration (minutes, 15-480):"

#: userland/programas/debug-app.c:420
msgid "Direcciones permitidas:"
msgstr "Allowed addresses:"

#: userland/programas/debug-app.c:430
msgid "«subred», redes (192.168.5.0/24) o direcciones, separadas por comas"
msgstr "«subred», networks (192.168.5.0/24) or addresses, separated by commas"

#: userland/programas/debug-app.c:435
msgid "Permitir también direcciones públicas (peligroso: solo detrás de una VPN)"
msgstr "Also allow public addresses (dangerous: only behind a VPN)"

#: userland/programas/debug-app.c:437
msgid "Permitir depuración remota"
msgstr "Allow remote debugging"

#: userland/programas/debug-app.c:443
msgid "Pide la contraseña de administrador. Más información: docs/debug-app.md"
msgstr "Asks for the administrator password. More information: docs/debug-app.md"

#: userland/programas/debug-app.c:446
msgid "SESIÓN REMOTA ACTIVA: quien tenga el código entra como root"
msgstr "REMOTE SESSION ACTIVE: whoever has the code logs in as root"

#: userland/programas/debug-app.c:449
msgid "Código (díctalo o cópialo al otro equipo):"
msgstr "Code (read it out or copy it to the other computer):"

#: userland/programas/debug-app.c:455
msgid "Copiar código"
msgstr "Copy code"

#: userland/programas/debug-app.c:461
msgid "El código ya se ha usado: no vale para nadie más."
msgstr "The code has already been used: it is not valid for anyone else."

#: userland/programas/debug-app.c:464
msgid "Preparando el código..."
msgstr "Preparing the code..."

#: userland/programas/debug-app.c:468
#, c-format
msgid "Dirección: %s, puerto %d"
msgstr "Address: %s, port %d"

#: userland/programas/debug-app.c:471
#, c-format
msgid "Huella del servidor: %s"
msgstr "Server fingerprint: %s"

#: userland/programas/debug-app.c:476
#, c-format
msgid "Caduca en: %s"
msgstr "Expires in: %s"

#: userland/programas/debug-app.c:479
#, c-format
msgid "Permitidas: %s"
msgstr "Allowed: %s"

#: userland/programas/debug-app.c:485
msgid "Cortar"
msgstr "Cut off"

#: userland/programas/debug-app.c:496
msgid "DEBUG-APP: SESIÓN REMOTA ACTIVA"
msgstr "DEBUG-APP: REMOTE SESSION ACTIVE"

#: userland/programas/debug-app.c:506
msgid "El puerto no es válido."
msgstr "The port is not valid."

#: userland/programas/debug-app.c:507
msgid "La duración va de 15 a 480 minutos."
msgstr "The duration goes from 15 to 480 minutes."

#: userland/programas/debug-app.c:519
msgid "La lista dice «publicas»: marca la casilla para confirmarlo."
msgstr "The list says «publicas»: tick the box to confirm it."

#: userland/programas/debug-app.c:526 userland/programas/debug-app.c:528
msgid "DEBUG-APP"
msgstr "DEBUG-APP"

#: userland/programas/debug-app.c:526
msgid "Has permitido direcciones públicas: cualquiera de Internet que llegue a este puerto podría probar el código. ¿Seguro?"
msgstr "You have allowed public addresses: anyone on the Internet who reaches this port could try the code. Are you sure?"

#: userland/programas/debug-app.c:529
msgid "La sesión remota ejecutará órdenes como ADMINISTRADOR (root): podrá leer, cambiar y borrar cualquier cosa. Dale el código solo a quien vaya a depurar este equipo. ¿Abrir la sesión?"
msgstr "The remote session will run commands as ADMINISTRATOR (root): it can read, change and delete anything. Give the code only to whoever is going to debug this computer. Open the session?"

#: userland/programas/debug-app.c:534
msgid "abrir una sesión de depuración remota como administrador (root)"
msgstr "open a remote debugging session as administrator (root)"

#: userland/programas/debug-app.c:535
msgid "Cancelado: hacen falta permisos de administrador."
msgstr "Cancelled: administrator permissions are needed."

#: userland/programas/debug-app.c:545
msgid "DEBUG-APP: depuración remota permitida (root). Ciérrala con «Cortar»."
msgstr "DEBUG-APP: remote debugging allowed (root). Close it with «Cut off»."

#: userland/programas/debug-app.c:553
msgid "debug-app: no se pudo abrir la ventana (¿hay escritorio?); usa «debug-app --texto»\n"
msgstr "debug-app: could not open the window (is there a desktop?); use «debug-app --texto»\n"

#: userland/programas/debug-app.c:584 userland/programas/debug-app.c:611 userland/programas/debug-app.c:620
msgid "DEBUG-APP: la sesión remota se ha cerrado."
msgstr "DEBUG-APP: the remote session has been closed."

#: userland/programas/debug-app.c:603
msgid "Código copiado al portapapeles."
msgstr "Code copied to the clipboard."

