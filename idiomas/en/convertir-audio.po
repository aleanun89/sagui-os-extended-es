msgstr "Choose the destination folder"

#: userland/programas/convertir-audio.c:746 userland/programas/convertir-audio.c:857
msgid "Carpeta de destino"
msgstr "Destination folder"

#: userland/programas/convertir-audio.c:746
msgid "La carpeta de destino no existe. ¿Crearla?"
msgstr "The destination folder does not exist. Create it?"

#: userland/programas/convertir-audio.c:747
msgid "No se puede usar esa carpeta de destino"
msgstr "That destination folder cannot be used"

#: userland/programas/convertir-audio.c:761
#, c-format
msgid ""
"Ya existe %d archivo en el destino.\n"
"¿Sobrescribirlo? (No: se omite)"
msgstr "%d file already exists in the destination.\nOverwrite it? (No: it is skipped)"

#: userland/programas/convertir-audio.c:761
#, c-format
msgid ""
"Ya existen %d archivos en el destino.\n"
"¿Sobrescribirlos? (No: se omiten)"
msgstr "%d files already exist in the destination.\nOverwrite them? (No: they are skipped)"

#: userland/programas/convertir-audio.c:762
msgid "El destino existe"
msgstr "The destination exists"

#: userland/programas/convertir-audio.c:820
msgid "Añadir archivo de sonido"
msgstr "Add sound file"

#: userland/programas/convertir-audio.c:827
