msgstr "Done: %d files converted in %u s"

#: userland/programas/convertir-audio.c:717
#, c-format
msgid "%s: el destino es el propio archivo de origen"
msgstr "%s: the destination is the source file itself"

#: userland/programas/convertir-audio.c:742
