msgstr "List full"

#: userland/programas/convertir-audio.c:589
#, c-format
msgid "No hay archivos de sonido en %s"
msgstr "No sound files in %s"

#: userland/programas/convertir-audio.c:622
msgid "Tasa (kbps):"
msgstr "Bit rate (kbps):"

#: userland/programas/convertir-audio.c:622
msgid "Compresión:"
