msgstr "Add the sound files you want to convert."

#: userland/programas/convertir-audio.c:650
msgid "Formato:"
msgstr "Format:"

#: userland/programas/convertir-audio.c:654
msgid "Frecuencia:"
msgstr "Sample rate:"

#: userland/programas/convertir-audio.c:656
msgid "Canales:"
msgstr "Channels:"

#: userland/programas/convertir-audio.c:659
msgid "Destino:"
msgstr "Destination:"

#: userland/programas/convertir-audio.c:668
msgid "Archivo actual"
msgstr "Current file"

#: userland/programas/convertir-audio.c:668
msgid "Archivo"
msgstr "File"

#: userland/programas/convertir-audio.c:669
msgid "Total"
msgstr "Total"

#: userland/programas/convertir-audio.c:677
msgid "MP3 a 11,025 kHz es MPEG-2.5: muchos reproductores no lo leen"
msgstr "MP3 at 11.025 kHz is MPEG-2.5: many players cannot read it"

#: userland/programas/convertir-audio.c:678
msgid "A esa frecuencia el MP3 admite como mucho 160 kbps"
msgstr "At that sample rate MP3 allows 160 kbps at most"

#: userland/programas/convertir-audio.c:679
#, c-format
msgid "%d archivos en la lista"
msgstr "%d files in the list"

#: userland/programas/convertir-audio.c:701
#, c-format
msgid "Cancelado: %d convertidos"
msgstr "Cancelled: %d converted"

#: userland/programas/convertir-audio.c:702
#, c-format
msgid "Hecho: %d convertidos, %d con error, %d omitidos"
msgstr "Done: %d converted, %d with errors, %d skipped"

#: userland/programas/convertir-audio.c:703
#, c-format
