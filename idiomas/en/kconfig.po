# Traducción de SaguiOS: catálogo «kconfig», idioma en (D313).
# Los msgid son los textos en español del código: no se cambian a mano.
msgid ""
msgstr ""
"Project-Id-Version: SaguiOS-Extended\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: userland/programas/kconfig.c:26
#, c-format
msgid "kconfig: este kernel no tiene opciones guardables (%d)\n"
msgstr "kconfig: this kernel has no saveable options (%d)\n"

#: userland/programas/kconfig.c:42
msgid "Opciones del kernel (se aplican al reiniciar):\n"
msgstr "Kernel options (applied on restart):\n"

#: userland/programas/kconfig.c:43
msgid "OPCIÓN"
msgstr "OPTION"

#: userland/programas/kconfig.c:43
msgid "AHORA"
msgstr "NOW"

#: userland/programas/kconfig.c:43
msgid "IMAGEN"
msgstr "IMAGE"

#: userland/programas/kconfig.c:43
msgid "GUARDADO"
msgstr "SAVED"

#: userland/programas/kconfig.c:43
msgid "AL REINICIAR"
msgstr "ON RESTART"

#: userland/programas/kconfig.c:53
msgid "(guardado fuera de rango: ignorado)"
msgstr "(saved value out of range: ignored)"

#: userland/programas/kconfig.c:54
msgid "(no aplicado: modo rescate)"
msgstr "(not applied: rescue mode)"

#: userland/programas/kconfig.c:55
msgid "cambia al reiniciar"
msgstr "changes on restart"

#: userland/programas/kconfig.c:59
msgid "Modo rescate: lo guardado no se aplica en este arranque. «kconfig --por-defecto» lo borra.\n"
msgstr "Rescue mode: the saved settings are not applied in this boot. «kconfig --por-defecto» erases them.\n"

#: userland/programas/kconfig.c:61
msgid "Aviso: lo guardado está dañado y no se aplica; al guardar algo se empieza de cero.\n"
msgstr "Warning: the saved settings are damaged and not applied; saving anything starts from scratch.\n"

#: userland/programas/kconfig.c:63
msgid "Arranque desde CD: no se puede guardar nada.\n"
msgstr "Booted from CD: nothing can be saved.\n"

#: userland/programas/kconfig.c:64
msgid "Hay cambios guardados que se aplicarán al reiniciar.\n"
msgstr "There are saved changes that will be applied on restart.\n"

#: userland/programas/kconfig.c:69
msgid "uso: kconfig [OPCION=VALOR ...] | kconfig --por-defecto\n"
msgstr "usage: kconfig [OPTION=VALUE ...] | kconfig --por-defecto\n"

#: userland/programas/kconfig.c:70
msgid "Valores: si|no, un número, auto, o «defecto» (vuelve al de la imagen).\n"
msgstr "Values: si|no, a number, auto, or «defecto» (back to the image value).\n"

#: userland/programas/kconfig.c:80
msgid "Si lo guardado impide arrancar: Ctrl al arrancar (modo rescate) y «kconfig --por-defecto».\n"
msgstr "If the saved settings prevent booting: hold Ctrl while booting (rescue mode) and run «kconfig --por-defecto».\n"

#: userland/programas/kconfig.c:86
#, c-format
msgid "kconfig: hace falta ser administrador (usa: admin kconfig %s)\n"
msgstr "kconfig: administrator rights are required (use: admin kconfig %s)\n"

#: userland/programas/kconfig.c:88
msgid "kconfig: SaguiOS ha arrancado desde un CD, que es de solo lectura: no se puede guardar\n"
msgstr "kconfig: SaguiOS was booted from a CD, which is read-only: cannot save\n"

#: userland/programas/kconfig.c:90
msgid "kconfig: no se encontró el disco de arranque de SaguiOS para guardar\n"
msgstr "kconfig: the SaguiOS boot disk was not found to save to\n"

#: userland/programas/kconfig.c:91
#, c-format
msgid "kconfig: %s: no se pudo guardar: %s\n"
msgstr "kconfig: %s: could not save: %s\n"

#: userland/programas/kconfig.c:106
msgid "Configuración del kernel borrada: al reiniciar, los valores de la imagen.\n"
msgstr "Kernel settings erased: the image values will be used on restart.\n"

#: userland/programas/kconfig.c:118
#, c-format
msgid "kconfig: «%s»: se espera OPCION=VALOR (kconfig -h)\n"
msgstr "kconfig: «%s»: OPTION=VALUE expected (kconfig -h)\n"

#: userland/programas/kconfig.c:123
#, c-format
msgid "kconfig: no hay ninguna opción «%s» (kconfig -h)\n"
msgstr "kconfig: there is no option «%s» (kconfig -h)\n"

#: userland/programas/kconfig.c:127
#, c-format
msgid "kconfig: %s: «%s» no vale (si o no)\n"
msgstr "kconfig: %s: «%s» is not valid (si or no)\n"

#: userland/programas/kconfig.c:128
#, c-format
msgid "kconfig: %s: «%s» fuera de rango (auto o de %u a %u)\n"
msgstr "kconfig: %s: «%s» out of range (auto or %u to %u)\n"

#: userland/programas/kconfig.c:148
#, c-format
msgid "%s: vuelve al de la imagen (%s)"
msgstr "%s: back to the image value (%s)"

#: userland/programas/kconfig.c:149
#, c-format
msgid "%s: guardado %s"
msgstr "%s: saved %s"

#: userland/programas/kconfig.c:150
msgid "; se aplica al reiniciar"
msgstr "; applied on restart"

