#: userland/programas/wifi.c:332
msgid "wifi: la clave WEP tiene 5 o 13 caracteres, o 10 o 26 cifras hexadecimales\n"
msgstr "wifi: the WEP key has 5 or 13 characters, or 10 or 26 hex digits\n"

#: userland/programas/wifi.c:336
#, c-format
msgid "AVISO: %s usa WEP, que no protege nada: cualquiera cerca puede leer y falsificar el tráfico. Cámbialo a WPA2-AES o WPA3.\n"
msgstr "WARNING: %s uses WEP, which protects nothing: anyone nearby can read and forge the traffic. Switch to WPA2-AES or WPA3.\n"

#: userland/programas/wifi.c:342
msgid "wifi: la clave de WPA/WPA2 tiene de 8 a 63 caracteres ASCII\n"
msgstr "wifi: the WPA/WPA2 key has 8 to 63 ASCII characters\n"

#: userland/programas/wifi.c:346
#, c-format
msgid "AVISO: %s usa TKIP, que está obsoleto. Mejor WPA2-AES o WPA3.\n"
msgstr "WARNING: %s uses TKIP, which is obsolete. Prefer WPA2-AES or WPA3.\n"

#: userland/programas/wifi.c:349
msgid "wifi: la contraseña de WPA3 tiene de 1 a 128 caracteres\n"
msgstr "wifi: the WPA3 password has 1 to 128 characters\n"

