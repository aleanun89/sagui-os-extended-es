#: userland/programas/wifi_ventana.h:381 userland/programas/wifi_ventana.h:417
msgid "Redes Wi-Fi"
msgstr "Wi-Fi networks"

#: userland/programas/wifi_ventana.h:410
msgid "Desconectado."
msgstr "Disconnected."

#: userland/programas/wifi_ventana.h:417
msgid "¿Olvidar esta red? Habrá que escribir la contraseña otra vez."
msgstr "Forget this network? You will have to type the password again."

#: userland/programas/wifi_ventana.h:423
