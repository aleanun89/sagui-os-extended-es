msgid "Elige una red y pulsa «Conectar» (o doble clic)."
msgstr "Pick a network and click \"Connect\" (or double-click)."

#: userland/programas/wifi_ventana.h:258
msgid "Conectar y desconectar no necesita ser administrador."
msgstr "Connecting and disconnecting does not need an administrator."

#: userland/programas/wifi_ventana.h:269
msgid "Solo la sesión local o root pueden conectar o desconectar el Wi-Fi."
msgstr "Only the local session or root can connect or disconnect Wi-Fi."

