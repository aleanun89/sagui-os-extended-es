msgstr "Tree view"

#: userland/programas/htop.c:970
msgid "Mostrar los hilos"
msgstr "Show threads"

#: userland/programas/htop.c:976
msgid "Configuración (Intro cambia, Esc cierra)"
msgstr "Setup (Enter toggles, Esc closes)"

