#: userland/programas/htop.c:899
msgid "Flechas, Re/Av Pág, Inicio, Fin: moverse por la lista"
msgstr "Arrows, PgUp/PgDn, Home, End: move through the list"

#: userland/programas/htop.c:900
msgid "F3 /: buscar      F4 \\: filtrar      Esc: quitar el filtro"
msgstr "F3 /: search      F4 \\: filter      Esc: clear the filter"

#: userland/programas/htop.c:901
msgid "F5 t: árbol       H: hilos           K: ocultar los del kernel"
msgstr "F5 t: tree        H: threads         K: hide kernel tasks"

#: userland/programas/htop.c:902
msgid "F6 > .: ordenar por una columna       I: invertir"
msgstr "F6 > .: sort by a column       I: invert"

#: userland/programas/htop.c:903
msgid "P: por CPU   M: por memoria   T: por tiempo   N: por PID"
msgstr "P: by CPU   M: by memory   T: by time   N: by PID"

#: userland/programas/htop.c:904
msgid "F7 ]: más prioridad (nice -; solo root)  F8 [: menos (nice +)"
msgstr "F7 ]: more priority (nice -; root only)  F8 [: less (nice +)"

#: userland/programas/htop.c:905
msgid "F9 k: matar (a los marcados, o al seleccionado)"
msgstr "F9 k: kill (the marked ones, or the selected one)"

#: userland/programas/htop.c:906
msgid "Espacio: marcar    U: desmarcar todos   F: seguir el proceso"
msgstr "Space: mark    U: unmark all   F: follow the process"

#: userland/programas/htop.c:907
msgid "u: solo los procesos de un usuario"
msgstr "u: only the processes of one user"

#: userland/programas/htop.c:908
msgid "F2 S: configuración (columnas, intervalo, colores)"
msgstr "F2 S: setup (columns, interval, colors)"

#: userland/programas/htop.c:909
msgid "Ctrl+L: redibujar    F10 q: salir"
msgstr "Ctrl+L: redraw    F10 q: quit"

#: userland/programas/htop.c:910
msgid "Ratón: clic en una línea, en un título de columna o en la barra de F"
msgstr "Mouse: click a row, a column title or the F-key bar"

#: userland/programas/htop.c:912
msgid "Ayuda de htop"
msgstr "htop help"

