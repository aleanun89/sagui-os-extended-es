#!/bin/python
# chip8-roms - descarga ROM del Chip8 Community Archive (CC0) y las juega (D123).
# En SaguiOS es /bin/chip8-roms; la lógica común está en /lib/python/chip8roms.py.
import sys
import chip8roms as c8

AYUDA = """uso: chip8-roms <orden> [opciones]
  lista [--plataforma chip8|schip|xochip] [--buscar texto]   programas del archivo
  info <clave>                                               descripcion y opciones
  bajar <clave>... | bajar --todas [--plataforma X]           descarga las ROM
  jugar <clave>                                              la baja si falta y abre chip8
Opciones: --url BASE   otro servidor (espejo o pruebas)   --carpeta DIR   donde guardar
ROM de John Earnest y otros autores, Chip8 Community Archive (licencia CC0):
https://github.com/JohnEarnest/chip8Archive. No vienen con SaguiOS: se bajan al usarlas.
Las ROM bajadas salen tambien en el selector de /bin/chip8 (marcadas con +).
Version grafica: chip8-roms-gui."""


def error(msg):
    print("chip8-roms: " + msg)
    sys.exit(1)


def leer(args):
    """Separa opciones y posicionales."""
    op = {"url": None, "plataforma": None, "buscar": None, "todas": False, "carpeta": None}
    pos = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--todas":
            op["todas"] = True
        elif a in ("--url", "--plataforma", "--buscar", "--carpeta"):
            i += 1
            if i >= len(args):
                error("falta el valor de " + a)
            op[a[2:]] = args[i]
        elif a.startswith("--"):
            error("opcion desconocida " + a)
        else:
            pos.append(a)
        i += 1
    if op["plataforma"] and op["plataforma"] not in c8.PLATAFORMAS:
        error("plataforma desconocida '%s' (chip8, schip o xochip)" % op["plataforma"])
    return op, pos


def indice(op):
    try:
        return c8.cargar_indice(op["url"], False, op["carpeta"], aviso=print)
    except OSError as e:
        error("no se pudo obtener el indice: %s" % e)


def aviso_home(op):
    a = c8.aviso_persistencia(op["carpeta"])
    if a:
        print(a)


def cmd_lista(op, pos):
    ind = indice(op)
    res = c8.filtrar(ind, op["plataforma"], op["buscar"])
    bajadas = 0
    for clave, p in res:
        b = c8.esta_bajada(clave, p, op["carpeta"])
        bajadas += 1 if b else 0
        print("%s %-20s %-7s %s (%s)" % ("[x]" if b else "[ ]", clave, c8.plataforma(p), p.get("title", clave), c8.autores(p)))
    print("%d programas, %d descargados ([x]). ROM con licencia %s" % (len(res), bajadas, c8.LICENCIA))


def cmd_info(op, pos):
    if len(pos) != 1:
        error("uso: chip8-roms info <clave>")
    ind = indice(op)
    clave = pos[0]
    if clave not in ind:
        error("no existe '%s' (mira chip8-roms lista)" % clave)
    p = ind[clave]
    print("Clave:       " + clave)
    print("Titulo:      " + p.get("title", clave))
    print("Autores:     " + c8.autores(p))
    print("Plataforma:  " + c8.plataforma(p))
    print("Evento:      " + (p.get("event") or "-"))
    print("Fecha:       " + (p.get("release") or "-"))
    print("Descripcion: " + (p.get("desc") or "-"))
    print("Licencia:    " + c8.LICENCIA)
    if c8.esta_bajada(clave, p, op["carpeta"]):
        print("Descargada:  si, " + c8.ruta_rom(clave, p, op["carpeta"]))
    else:
        print("Descargada:  no")
    o = p.get("options", {})
    for k in sorted(o):
        print("  opcion %s = %s" % (k, o[k]))
    linea, avisos = c8.linea_emulador(clave, p, op["carpeta"])
    print("Emulador:    " + linea)
    for a in avisos:
        print("  aviso: " + a)


def bajar_uno(op, ind, clave, n, total):
    p = ind[clave]
    print("[%d/%d] %s (%s) ..." % (n, total, clave, p.get("title", clave)))
    try:
        ruta = c8.bajar_rom(clave, p, op["url"], op["carpeta"], aviso=print)
    except OSError as e:
        print("  ERROR: %s" % e)
        return False
    print("  listo: " + ruta)
    return True


def cmd_bajar(op, pos):
    ind = indice(op)
    if op["todas"]:
        claves = [k for k, _ in c8.filtrar(ind, op["plataforma"], op["buscar"])]
    else:
        claves = pos
    if not claves:
        error("uso: chip8-roms bajar <clave>... | bajar --todas")
    for k in claves:
        if k not in ind:
            error("no existe '%s'" % k)
    aviso_home(op)
    bien = 0
    for i, k in enumerate(claves):
        if bajar_uno(op, ind, k, i + 1, len(claves)):
            bien += 1
    print("%d de %d descargadas en %s (%s)" % (bien, len(claves), c8.carpeta_roms(op["carpeta"]), c8.LICENCIA))
    if bien < len(claves):
        sys.exit(1)


def cmd_jugar(op, pos):
    if len(pos) != 1:
        error("uso: chip8-roms jugar <clave>")
    ind = indice(op)
    clave = pos[0]
    if clave not in ind:
        error("no existe '%s'" % clave)
    p = ind[clave]
    if not c8.esta_bajada(clave, p, op["carpeta"]):
        aviso_home(op)
        if not bajar_uno(op, ind, clave, 1, 1):
            sys.exit(1)
    linea, avisos = c8.linea_emulador(clave, p, op["carpeta"])
    for a in avisos:
        print("aviso: " + a)
    print("chip8-roms: " + linea)
    c8.jugar(clave, p, op["carpeta"])


def principal():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--ayuda", "ayuda"):
        print(AYUDA)
        return
    op, pos = leer(args[1:])
    tabla = {"lista": cmd_lista, "info": cmd_info, "bajar": cmd_bajar, "jugar": cmd_jugar}
    if args[0] not in tabla:
        error("orden desconocida '%s' (lista, info, bajar, jugar)" % args[0])
    tabla[args[0]](op, pos)


principal()
